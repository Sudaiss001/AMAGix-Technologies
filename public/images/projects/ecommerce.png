<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 1200 675" width="100%" height="100%">
  <defs>
    <linearGradient id="bg" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#0B0F17" />
      <stop offset="50%" stop-color="#0F172A" />
      <stop offset="100%" stop-color="#1E293B" />
    </linearGradient>
    <linearGradient id="accent" x1="0%" y1="0%" x2="100%" y2="0%">
      <stop offset="0%" stop-color="#06B6D4" />
      <stop offset="100%" stop-color="#10B981" />
    </linearGradient>
    <linearGradient id="cardGrad" x1="0%" y1="0%" x2="0%" y2="100%">
      <stop offset="0%" stop-color="#1E293B" />
      <stop offset="100%" stop-color="#0F172A" />
    </linearGradient>
  </defs>

  <!-- Background -->
  <rect width="1200" height="675" fill="url(#bg)" />

  <!-- Navbar -->
  <rect x="0" y="0" width="1200" height="60" fill="#0B0F17" opacity="0.9" />
  <line x1="0" y1="60" x2="1200" y2="60" stroke="#334155" stroke-width="1" />
  <circle cx="40" cy="30" r="14" fill="url(#accent)" />
  <text x="65" y="36" fill="#FFFFFF" font-family="system-ui, sans-serif" font-weight="800" font-size="18">AMAGix Store</text>
  
  <!-- Nav items -->
  <text x="240" y="35" fill="#06B6D4" font-family="sans-serif" font-size="13" font-weight="600">All Products</text>
  <text x="340" y="35" fill="#94A3B8" font-family="sans-serif" font-size="13">Categories</text>
  <text x="430" y="35" fill="#94A3B8" font-family="sans-serif" font-size="13">Deals</text>
  
  <!-- Search Bar -->
  <rect x="700" y="16" width="320" height="28" rx="6" fill="#1E293B" stroke="#334155" />
  <text x="715" y="34" fill="#64748B" font-family="sans-serif" font-size="11">Search electronics, gadgets...</text>
  
  <!-- Cart Button -->
  <rect x="1040" y="16" width="120" height="28" rx="6" fill="url(#accent)" />
  <text x="1070" y="34" fill="#090D16" font-family="sans-serif" font-size="12" font-weight="700">Cart (3)</text>

  <!-- Hero Section Banner -->
  <rect x="40" y="85" width="1120" height="150" rx="12" fill="url(#cardGrad)" stroke="#334155" />
  <text x="80" y="140" fill="#06B6D4" font-family="sans-serif" font-size="12" font-weight="700" letter-spacing="1">SPECIAL PROMOTION</text>
  <text x="80" y="175" fill="#FFFFFF" font-family="sans-serif" font-size="26" font-weight="800">Next-Gen Enterprise Tech & Electronics</text>
  <text x="80" y="205" fill="#94A3B8" font-family="sans-serif" font-size="13">Fast local checkout with automated Paystack & Flutterwave payment processing.</text>

  <!-- Product Grid Section Header -->
  <text x="40" y="270" fill="#FFFFFF" font-family="sans-serif" font-size="18" font-weight="700">Featured Catalog</text>
  <text x="1070" y="270" fill="#06B6D4" font-family="sans-serif" font-size="12">View All →</text>

  <!-- Product Card 1 -->
  <g transform="translate(40, 290)">
    <rect width="260" height="340" rx="10" fill="#1E293B" stroke="#334155" />
    <rect x="15" y="15" width="230" height="150" rx="8" fill="#0F172A" />
    <circle cx="130" cy="90" r="35" fill="#06B6D4" opacity="0.2" />
    <text x="130" y="96" fill="#06B6D4" font-family="sans-serif" font-size="28" text-anchor="middle">💻</text>
    <text x="15" y="190" fill="#FFFFFF" font-family="sans-serif" font-size="14" font-weight="700">Pro Laptop 16-inch</text>
    <text x="15" y="210" fill="#94A3B8" font-family="sans-serif" font-size="11">Core i7 / 32GB RAM / 1TB SSD</text>
    <text x="15" y="250" fill="#10B981" font-family="sans-serif" font-size="18" font-weight="800">₦850,000</text>
    <rect x="15" y="275" width="230" height="36" rx="6" fill="url(#accent)" />
    <text x="130" y="298" fill="#090D16" font-family="sans-serif" font-size="12" font-weight="700" text-anchor="middle">Add to Cart</text>
  </g>

  <!-- Product Card 2 -->
  <g transform="translate(326, 290)">
    <rect width="260" height="340" rx="10" fill="#1E293B" stroke="#334155" />
    <rect x="15" y="15" width="230" height="150" rx="8" fill="#0F172A" />
    <circle cx="130" cy="90" r="35" fill="#10B981" opacity="0.2" />
    <text x="130" y="96" fill="#10B981" font-family="sans-serif" font-size="28" text-anchor="middle">📱</text>
    <text x="15" y="190" fill="#FFFFFF" font-family="sans-serif" font-size="14" font-weight="700">Ultra Smartphone 5G</text>
    <text x="15" y="210" fill="#94A3B8" font-family="sans-serif" font-size="11">256GB Storage / OLED 120Hz</text>
    <text x="15" y="250" fill="#10B981" font-family="sans-serif" font-size="18" font-weight="800">₦420,000</text>
    <rect x="15" y="275" width="230" height="36" rx="6" fill="url(#accent)" />
    <text x="130" y="298" fill="#090D16" font-family="sans-serif" font-size="12" font-weight="700" text-anchor="middle">Add to Cart</text>
  </g>

  <!-- Product Card 3 -->
  <g transform="translate(612, 290)">
    <rect width="260" height="340" rx="10" fill="#1E293B" stroke="#334155" />
    <rect x="15" y="15" width="230" height="150" rx="8" fill="#0F172A" />
    <circle cx="130" cy="90" r="35" fill="#8B5CF6" opacity="0.2" />
    <text x="130" y="96" fill="#8B5CF6" font-family="sans-serif" font-size="28" text-anchor="middle">🎧</text>
    <text x="15" y="190" fill="#FFFFFF" font-family="sans-serif" font-size="14" font-weight="700">Wireless Noise-Canceling</text>
    <text x="15" y="210" fill="#94A3B8" font-family="sans-serif" font-size="11">Active ANC / 40h Battery</text>
    <text x="15" y="250" fill="#10B981" font-family="sans-serif" font-size="18" font-weight="800">₦85,000</text>
    <rect x="15" y="275" width="230" height="36" rx="6" fill="url(#accent)" />
    <text x="130" y="298" fill="#090D16" font-family="sans-serif" font-size="12" font-weight="700" text-anchor="middle">Add to Cart</text>
  </g>

  <!-- Product Card 4 -->
  <g transform="translate(898, 290)">
    <rect width="260" height="340" rx="10" fill="#1E293B" stroke="#334155" />
    <rect x="15" y="15" width="230" height="150" rx="8" fill="#0F172A" />
    <circle cx="130" cy="90" r="35" fill="#F59E0B" opacity="0.2" />
    <text x="130" y="96" fill="#F59E0B" font-family="sans-serif" font-size="28" text-anchor="middle">⌚</text>
    <text x="15" y="190" fill="#FFFFFF" font-family="sans-serif" font-size="14" font-weight="700">Smart Fitness Watch</text>
    <text x="15" y="210" fill="#94A3B8" font-family="sans-serif" font-size="11">Heart Rate / GPS / Water Resistant</text>
    <text x="15" y="250" fill="#10B981" font-family="sans-serif" font-size="18" font-weight="800">₦65,000</text>
    <rect x="15" y="275" width="230" height="36" rx="6" fill="url(#accent)" />
    <text x="130" y="298" fill="#090D16" font-family="sans-serif" font-size="12" font-weight="700" text-anchor="middle">Add to Cart</text>
  </g>
</svg>
