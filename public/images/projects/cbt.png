<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 1200 675" width="100%" height="100%">
  <defs>
    <linearGradient id="bg" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#0B0F17" />
      <stop offset="50%" stop-color="#0F172A" />
      <stop offset="100%" stop-color="#1E293B" />
    </linearGradient>
    <linearGradient id="primary" x1="0%" y1="0%" x2="100%" y2="0%">
      <stop offset="0%" stop-color="#8B5CF6" />
      <stop offset="100%" stop-color="#06B6D4" />
    </linearGradient>
  </defs>

  <!-- Background -->
  <rect width="1200" height="675" fill="url(#bg)" />

  <!-- Top Header Bar -->
  <rect x="0" y="0" width="1200" height="60" fill="#0B0F17" />
  <line x1="0" y1="60" x2="1200" y2="60" stroke="#334155" stroke-width="1" />
  <text x="40" y="36" fill="#FFFFFF" font-family="system-ui, sans-serif" font-weight="800" font-size="18">AMAGix CBT Portal</text>
  <text x="220" y="35" fill="#8B5CF6" font-family="sans-serif" font-size="12" font-weight="600">Terminal Examination Session 2026</text>
  
  <!-- Timer Box -->
  <rect x="960" y="12" width="200" height="36" rx="8" fill="#1E293B" stroke="#8B5CF6" />
  <text x="980" y="35" fill="#EF4444" font-family="monospace" font-size="14" font-weight="700">⏱ 00:42:15</text>
  <text x="1075" y="34" fill="#94A3B8" font-family="sans-serif" font-size="11">Remaining</text>

  <!-- Left Question Grid Panel (300px wide) -->
  <rect x="40" y="80" width="280" height="555" rx="10" fill="#1E293B" stroke="#334155" />
  <text x="60" y="115" fill="#FFFFFF" font-family="sans-serif" font-size="14" font-weight="700">Question Navigator</text>
  <text x="60" y="135" fill="#94A3B8" font-family="sans-serif" font-size="11">Answered: 18 / 50</text>

  <!-- Question Grid Circles -->
  <!-- Row 1 -->
  <circle cx="80" cy="180" r="18" fill="#10B981" /> <text x="80" y="185" fill="#FFFFFF" font-family="sans-serif" font-size="12" text-anchor="middle">1</text>
  <circle cx="130" cy="180" r="18" fill="#10B981" /> <text x="130" y="185" fill="#FFFFFF" font-family="sans-serif" font-size="12" text-anchor="middle">2</text>
  <circle cx="180" cy="180" r="18" fill="#10B981" /> <text x="180" y="185" fill="#FFFFFF" font-family="sans-serif" font-size="12" text-anchor="middle">3</text>
  <circle cx="230" cy="180" r="18" fill="#10B981" /> <text x="230" y="185" fill="#FFFFFF" font-family="sans-serif" font-size="12" text-anchor="middle">4</text>
  <circle cx="280" cy="180" r="18" fill="#10B981" /> <text x="280" y="185" fill="#FFFFFF" font-family="sans-serif" font-size="12" text-anchor="middle">5</text>
  <!-- Row 2 -->
  <circle cx="80" cy="230" r="18" fill="#8B5CF6" stroke="#FFFFFF" stroke-width="2" /> <text x="80" y="235" fill="#FFFFFF" font-family="sans-serif" font-size="12" text-anchor="middle">6</text>
  <circle cx="130" cy="230" r="18" fill="#334155" /> <text x="130" y="235" fill="#94A3B8" font-family="sans-serif" font-size="12" text-anchor="middle">7</text>
  <circle cx="180" cy="230" r="18" fill="#334155" /> <text x="180" y="235" fill="#94A3B8" font-family="sans-serif" font-size="12" text-anchor="middle">8</text>
  <circle cx="230" cy="230" r="18" fill="#334155" /> <text x="230" y="235" fill="#94A3B8" font-family="sans-serif" font-size="12" text-anchor="middle">9</text>
  <circle cx="280" cy="230" r="18" fill="#334155" /> <text x="280" y="235" fill="#94A3B8" font-family="sans-serif" font-size="12" text-anchor="middle">10</text>

  <!-- Legend -->
  <rect x="60" y="560" width="240" height="50" rx="6" fill="#0F172A" />
  <circle cx="80" cy="585" r="8" fill="#10B981" /> <text x="95" y="589" fill="#94A3B8" font-family="sans-serif" font-size="10">Answered</text>
  <circle cx="170" cy="585" r="8" fill="#334155" /> <text x="185" y="589" fill="#94A3B8" font-family="sans-serif" font-size="10">Pending</text>

  <!-- Main Question Display (800px wide) -->
  <rect x="340" y="80" width="820" height="555" rx="10" fill="#1E293B" stroke="#334155" />
  
  <!-- Question Title Header -->
  <text x="380" y="125" fill="#8B5CF6" font-family="sans-serif" font-size="14" font-weight="700">QUESTION 6 OF 50</text>
  <text x="380" y="165" fill="#FFFFFF" font-family="sans-serif" font-size="18" font-weight="700">Which of the following data structures operates on a Last-In, First-Out (LIFO) principle?</text>

  <!-- Options Grid -->
  <!-- Option A -->
  <rect x="380" y="210" width="740" height="60" rx="8" fill="#0F172A" stroke="#334155" />
  <circle cx="415" cy="240" r="12" fill="#334155" />
  <text x="415" y="244" fill="#FFFFFF" font-family="sans-serif" font-size="11" text-anchor="middle">A</text>
  <text x="445" y="245" fill="#CBD5E1" font-family="sans-serif" font-size="14">Queue (First-In, First-Out)</text>

  <!-- Option B (Selected) -->
  <rect x="380" y="290" width="740" height="60" rx="8" fill="#8B5CF6" opacity="0.15" stroke="#8B5CF6" stroke-width="2" />
  <circle cx="415" cy="320" r="12" fill="#8B5CF6" />
  <text x="415" y="324" fill="#FFFFFF" font-family="sans-serif" font-size="11" text-anchor="middle">B</text>
  <text x="445" y="325" fill="#FFFFFF" font-family="sans-serif" font-size="14" font-weight="700">Stack (Last-In, First-Out)</text>

  <!-- Option C -->
  <rect x="380" y="370" width="740" height="60" rx="8" fill="#0F172A" stroke="#334155" />
  <circle cx="415" cy="400" r="12" fill="#334155" />
  <text x="415" y="404" fill="#FFFFFF" font-family="sans-serif" font-size="11" text-anchor="middle">C</text>
  <text x="445" y="405" fill="#CBD5E1" font-family="sans-serif" font-size="14">Binary Search Tree</text>

  <!-- Option D -->
  <rect x="380" y="450" width="740" height="60" rx="8" fill="#0F172A" stroke="#334155" />
  <circle cx="415" cy="480" r="12" fill="#334155" />
  <text x="415" y="484" fill="#FFFFFF" font-family="sans-serif" font-size="11" text-anchor="middle">D</text>
  <text x="445" y="485" fill="#CBD5E1" font-family="sans-serif" font-size="14">Linked List</text>

  <!-- Action Controls -->
  <rect x="380" y="550" width="140" height="42" rx="8" fill="#334155" />
  <text x="450" y="576" fill="#FFFFFF" font-family="sans-serif" font-size="13" text-anchor="middle">← Previous</text>

  <rect x="540" y="550" width="140" height="42" rx="8" fill="url(#primary)" />
  <text x="610" y="576" fill="#FFFFFF" font-family="sans-serif" font-size="13" font-weight="700" text-anchor="middle">Next Question →</text>

  <rect x="960" y="550" width="160" height="42" rx="8" fill="#EF4444" />
  <text x="1040" y="576" fill="#FFFFFF" font-family="sans-serif" font-size="13" font-weight="700" text-anchor="middle">Submit Exam</text>
</svg>
