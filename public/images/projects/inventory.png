<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 1200 675" width="100%" height="100%">
  <defs>
    <linearGradient id="bg" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#0B0F17" />
      <stop offset="50%" stop-color="#0F172A" />
      <stop offset="100%" stop-color="#1E293B" />
    </linearGradient>
    <linearGradient id="primary" x1="0%" y1="0%" x2="100%" y2="0%">
      <stop offset="0%" stop-color="#06B6D4" />
      <stop offset="100%" stop-color="#10B981" />
    </linearGradient>
  </defs>

  <rect width="1200" height="675" fill="url(#bg)" />

  <!-- Top Bar -->
  <rect x="0" y="0" width="1200" height="60" fill="#0B0F17" />
  <line x1="0" y1="60" x2="1200" y2="60" stroke="#334155" stroke-width="1" />
  <text x="40" y="36" fill="#06B6D4" font-family="system-ui, sans-serif" font-weight="800" font-size="18">📦 Inventory & POS System</text>
  <text x="320" y="35" fill="#94A3B8" font-family="sans-serif" font-size="12">Commercial Retail POS & Barcode Management</text>

  <!-- Left POS Cart Section (760px) -->
  <g transform="translate(40, 80)">
    <rect x="0" y="0" width="740" height="555" rx="10" fill="#1E293B" stroke="#334155" />
    <text x="25" y="40" fill="#FFFFFF" font-family="sans-serif" font-size="16" font-weight="700">Active Register Terminal #04</text>
    
    <!-- Barcode Scanner Search Input -->
    <rect x="25" y="60" width="690" height="44" rx="8" fill="#0F172A" stroke="#06B6D4" stroke-width="2" />
    <text x="45" y="87" fill="#06B6D4" font-family="monospace" font-size="14">📷 Scan Barcode or Enter Product SKU [ 890124809214 ] ...</text>

    <!-- Cart Table Header -->
    <rect x="25" y="120" width="690" height="36" rx="6" fill="#0F172A" />
    <text x="45" y="143" fill="#94A3B8" font-family="sans-serif" font-size="11" font-weight="700">ITEM DESCRIPTION</text>
    <text x="350" y="143" fill="#94A3B8" font-family="sans-serif" font-size="11" font-weight="700">QTY</text>
    <text x="480" y="143" fill="#94A3B8" font-family="sans-serif" font-size="11" font-weight="700">PRICE</text>
    <text x="620" y="143" fill="#94A3B8" font-family="sans-serif" font-size="11" font-weight="700">TOTAL</text>

    <!-- Item 1 -->
    <text x="45" y="190" fill="#FFFFFF" font-family="sans-serif" font-size="13" font-weight="600">Enterprise Server Blade R750</text>
    <text x="350" y="190" fill="#06B6D4" font-family="sans-serif" font-size="13" font-weight="700">x 2</text>
    <text x="480" y="190" fill="#CBD5E1" font-family="sans-serif" font-size="13">₦1,250,000</text>
    <text x="620" y="190" fill="#10B981" font-family="sans-serif" font-size="13" font-weight="700">₦2,500,000</text>
    <line x1="25" y1="210" x2="715" y2="210" stroke="#334155" />

    <!-- Item 2 -->
    <text x="45" y="240" fill="#FFFFFF" font-family="sans-serif" font-size="13" font-weight="600">Cat6 Ethernet Spool (305m)</text>
    <text x="350" y="240" fill="#06B6D4" font-family="sans-serif" font-size="13" font-weight="700">x 5</text>
    <text x="480" y="240" fill="#CBD5E1" font-family="sans-serif" font-size="13">₦45,000</text>
    <text x="620" y="240" fill="#10B981" font-family="sans-serif" font-size="13" font-weight="700">₦225,000</text>
    <line x1="25" y1="260" x2="715" y2="260" stroke="#334155" />
  </g>

  <!-- Right Summary & Checkout Panel (360px) -->
  <g transform="translate(800, 80)">
    <rect x="0" y="0" width="360" height="555" rx="10" fill="#1E293B" stroke="#334155" />
    <text x="25" y="40" fill="#FFFFFF" font-family="sans-serif" font-size="16" font-weight="700">Order Payment Summary</text>
    
    <rect x="25" y="60" width="310" height="110" rx="10" fill="#0F172A" stroke="#10B981" />
    <text x="45" y="90" fill="#94A3B8" font-family="sans-serif" font-size="12">TOTAL DUE</text>
    <text x="45" y="135" fill="#10B981" font-family="sans-serif" font-size="32" font-weight="800">₦2,725,000</text>

    <!-- Payment Buttons -->
    <rect x="25" y="200" width="310" height="50" rx="8" fill="url(#primary)" />
    <text x="180" y="230" fill="#090D16" font-family="sans-serif" font-size="14" font-weight="800" text-anchor="middle">💳 Card Payment (POS)</text>

    <rect x="25" y="265" width="310" height="50" rx="8" fill="#10B981" />
    <text x="180" y="295" fill="#090D16" font-family="sans-serif" font-size="14" font-weight="800" text-anchor="middle">💵 Cash Payment</text>

    <rect x="25" y="330" width="310" height="50" rx="8" fill="#334155" />
    <text x="180" y="360" fill="#FFFFFF" font-family="sans-serif" font-size="14" font-weight="700" text-anchor="middle">🖨 Print Thermal Receipt</text>
  </g>
</svg>
